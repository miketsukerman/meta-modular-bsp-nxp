From 1acd1710654e14eb2e4b87f51f7d181020471dc4 Mon Sep 17 00:00:00 2001
From: "copilot-swe-agent[bot]" <198982749+Copilot@users.noreply.github.com>
Date: Mon, 20 Jul 2026 14:57:39 +0000
Subject: [PATCH 3/4] Restore runtime i.MX container header alignment for
 i.MX95
Upstream-Status: Inappropriate
---
 arch/arm/include/asm/mach-imx/sys_proto.h |  1 +
 arch/arm/mach-imx/image-container.c       | 24 ++++++++++++-----------
 arch/arm/mach-imx/imx9/qb.c               |  4 ++--
 arch/arm/mach-imx/imx9/scmi/soc.c         |  8 ++++++++
 common/spl/spl_imx_container.c            |  7 ++++---
 include/imx_container.h                   | 11 +++++++++--
 6 files changed, 37 insertions(+), 18 deletions(-)

diff --git a/arch/arm/include/asm/mach-imx/sys_proto.h b/arch/arm/include/asm/mach-imx/sys_proto.h
index 72faf1e4b30..4c552f64598 100644
--- a/arch/arm/include/asm/mach-imx/sys_proto.h
+++ b/arch/arm/include/asm/mach-imx/sys_proto.h
@@ -115,6 +115,7 @@ struct bd_info;
 
 #define is_imx94() (is_cpu_type(MXC_CPU_IMX94))
 #define is_imx95() (is_cpu_type(MXC_CPU_IMX95))
+#define is_imx95_a0() (is_imx95() && (soc_rev() < CHIP_REV_2_0))
 #define is_imx952() (is_cpu_type(MXC_CPU_IMX952))
 
 #define is_imx9121() (is_cpu_type(MXC_CPU_IMX9121))
diff --git a/arch/arm/mach-imx/image-container.c b/arch/arm/mach-imx/image-container.c
index 786ef100ea4..f1dfd21f11e 100644
--- a/arch/arm/mach-imx/image-container.c
+++ b/arch/arm/mach-imx/image-container.c
@@ -170,7 +170,8 @@ int get_container_size(ulong addr, u16 *header_length)
 
 static int get_dev_container_size(void *dev, int dev_type, unsigned long offset, u16 *header_length, bool *v2x_cntr)
 {
-	u8 *buf = malloc(CONTAINER_HDR_ALIGNMENT);
+	u16 ctnr_hdr_align = container_hdr_alignment();
+	u8 *buf = malloc(ctnr_hdr_align);
 	int ret = 0;
 
 	if (!buf) {
@@ -185,11 +186,11 @@ static int get_dev_container_size(void *dev, int dev_type, unsigned long offset,
 
 		count = blk_dread(mmc_get_blk_desc(mmc),
 				  offset / mmc->read_bl_len,
-				  CONTAINER_HDR_ALIGNMENT / mmc->read_bl_len,
+				  ctnr_hdr_align / mmc->read_bl_len,
 				  buf);
 		ctnr_log("get_dev_container_size: MMC read off 0x%lx (sector %lu, %u bytes) -> %lu blocks\n",
 			 offset, offset / mmc->read_bl_len,
-			 CONTAINER_HDR_ALIGNMENT, count);
+			 ctnr_hdr_align, count);
 		if (count == 0) {
 			free(buf);
 			printf("Read container image from MMC/SD failed\n");
@@ -203,7 +204,7 @@ static int get_dev_container_size(void *dev, int dev_type, unsigned long offset,
 		struct spi_flash *flash = (struct spi_flash *)dev;
 
 		ret = spi_flash_read(flash, offset,
-				     CONTAINER_HDR_ALIGNMENT, buf);
+				     ctnr_hdr_align, buf);
 		if (ret != 0) {
 			free(buf);
 			printf("Read container image from QSPI failed\n");
@@ -214,7 +215,7 @@ static int get_dev_container_size(void *dev, int dev_type, unsigned long offset,
 
 #ifdef CONFIG_SPL_NAND_SUPPORT
 	if (dev_type == NAND_DEV) {
-		ret = nand_spl_load_image(offset, CONTAINER_HDR_ALIGNMENT,
+		ret = nand_spl_load_image(offset, ctnr_hdr_align,
 					  buf);
 		if (ret != 0) {
 			free(buf);
@@ -226,12 +227,12 @@ static int get_dev_container_size(void *dev, int dev_type, unsigned long offset,
 
 #ifdef CONFIG_SPL_NOR_SUPPORT
 	if (dev_type == QSPI_NOR_DEV)
-		memcpy(buf, (const void *)offset, CONTAINER_HDR_ALIGNMENT);
+		memcpy(buf, (const void *)offset, ctnr_hdr_align);
 #endif
 
 #ifdef CONFIG_SPL_BOOTROM_SUPPORT
 	if (dev_type == ROM_API_DEV) {
-		ret = spl_romapi_read(offset, CONTAINER_HDR_ALIGNMENT, buf);
+		ret = spl_romapi_read(offset, ctnr_hdr_align, buf);
 		if (!ret) {
 			free(buf);
 			printf("Read container image from ROM API failed\n");
@@ -242,7 +243,7 @@ static int get_dev_container_size(void *dev, int dev_type, unsigned long offset,
 
 #ifdef CONFIG_SPL_RAM_SUPPORT
 	if (dev_type == RAM_DEV)
-		memcpy(buf, (const void *)offset, CONTAINER_HDR_ALIGNMENT);
+		memcpy(buf, (const void *)offset, ctnr_hdr_align);
 #endif
 
 
@@ -405,6 +406,7 @@ static __maybe_unused ulong get_imageset_end(void *dev, int dev_type)
 	int value_container[3] = {};
 	u16 hdr_length;
 	bool v2x_fw = false;
+	u16 ctnr_hdr_align = container_hdr_alignment();
 
 	offset[0] = get_boot_device_offset(dev, dev_type);
 	ctnr_log("get_imageset_end: dev_type %d seco offset[0] 0x%lx\n",
@@ -421,7 +423,7 @@ static __maybe_unused ulong get_imageset_end(void *dev, int dev_type)
 	debug("seco container size 0x%x\n", value_container[0]);
 
 	if (is_imx8dxl() || is_imx95() || is_imx94() || is_imx952()) {
-		offset[1] = ALIGN(hdr_length, CONTAINER_HDR_ALIGNMENT) + offset[0];
+		offset[1] = ALIGN(hdr_length, ctnr_hdr_align) + offset[0];
 		ctnr_log("get_imageset_end: v2x offset[1] 0x%lx\n", offset[1]);
 
 		value_container[1] = get_dev_container_size(dev, dev_type, offset[1], &hdr_length, &v2x_fw);
@@ -434,14 +436,14 @@ static __maybe_unused ulong get_imageset_end(void *dev, int dev_type)
 
 		if (v2x_fw) {
 			debug("v2x container size 0x%x\n", value_container[1]);
-			offset[2] = ALIGN(hdr_length, CONTAINER_HDR_ALIGNMENT) + offset[1];
+			offset[2] = ALIGN(hdr_length, ctnr_hdr_align) + offset[1];
 		} else {
 			printf("no v2x container included\n");
 			offset[2] = offset[1];
 		}
 	} else {
 		/* Skip offset[1] */
-		offset[2] = ALIGN(hdr_length, CONTAINER_HDR_ALIGNMENT) + offset[0];
+		offset[2] = ALIGN(hdr_length, ctnr_hdr_align) + offset[0];
 	}
 
 	ctnr_log("get_imageset_end: scu/next offset[2] 0x%lx\n", offset[2]);
diff --git a/arch/arm/mach-imx/imx9/qb.c b/arch/arm/mach-imx/imx9/qb.c
index cf633dfcda5..70e1b90fcfe 100644
--- a/arch/arm/mach-imx/imx9/qb.c
+++ b/arch/arm/mach-imx/imx9/qb.c
@@ -218,7 +218,7 @@ static int parse_container(void *addr, u32 *qb_data_off)
 static int get_dev_qbdata_offset(void *dev, int dev_type, unsigned long offset, u32 *qbdata_offset)
 {
 	int ret = 0;
-	u16 ctnr_hdr_align = CONTAINER_HDR_ALIGNMENT;
+	u16 ctnr_hdr_align = container_hdr_alignment();
 	void *buf = kmalloc(ctnr_hdr_align, GFP_KERNEL);
 
 	if (!buf) {
@@ -276,7 +276,7 @@ static int get_dev_qbdata_offset(void *dev, int dev_type, unsigned long offset,
 static int get_qbdata_offset(void *dev, int dev_type, u32 *qbdata_offset, bool bootdev)
 {
 	u32 offset = get_boot_device_offset(dev, dev_type, bootdev);
-	u16 ctnr_hdr_align = CONTAINER_HDR_ALIGNMENT;
+	u16 ctnr_hdr_align = container_hdr_alignment();
 	u32 cont_offset;
 	int ret, i;
 
diff --git a/arch/arm/mach-imx/imx9/scmi/soc.c b/arch/arm/mach-imx/imx9/scmi/soc.c
index 79114704d6d..f581bf19652 100644
--- a/arch/arm/mach-imx/imx9/scmi/soc.c
+++ b/arch/arm/mach-imx/imx9/scmi/soc.c
@@ -9,6 +9,7 @@
 #include <asm/arch/clock.h>
 #include <asm/arch/ddr.h>
 #include <asm/arch/sys_proto.h>
+#include <imx_container.h>
 #include <asm/armv8/mmu.h>
 #include <asm/mach-imx/boot_mode.h>
 #include <asm/mach-imx/optee.h>
@@ -2301,3 +2302,10 @@ void *arch_get_container_trampoline(void)
 
 	return (void *)((ulong)CFG_SYS_SDRAM_BASE + size - SZ_16M);
 }
+
+#ifdef CONFIG_IMX95
+u32 container_hdr_alignment(void)
+{
+	return is_imx95_a0() ? 0x400 : 0x4000;
+}
+#endif
diff --git a/common/spl/spl_imx_container.c b/common/spl/spl_imx_container.c
index b81b996c299..c544f9d3294 100644
--- a/common/spl/spl_imx_container.c
+++ b/common/spl/spl_imx_container.c
@@ -181,8 +181,9 @@ static int read_auth_container(struct spl_image_info *spl_image,
 	struct container_hdr *authhdr;
 	u16 length;
 	int i, size, ret = 0;
+	u16 ctnr_hdr_align = container_hdr_alignment();
 
-	size = ALIGN(CONTAINER_HDR_ALIGNMENT, spl_get_bl_len(info));
+	size = ALIGN(ctnr_hdr_align, spl_get_bl_len(info));
 
 	/*
 	 * It will not override the ATF code, so safe to use it here,
@@ -197,7 +198,7 @@ static int read_auth_container(struct spl_image_info *spl_image,
 	ctnr_log("read_auth_container: reading hdr @off 0x%lx size 0x%x bl_len %u\n",
 		 offset, size, spl_get_bl_len(info));
 	if (info->read(info, offset, size, container) <
-	    CONTAINER_HDR_ALIGNMENT) {
+	    ctnr_hdr_align) {
 		ctnr_log("read_auth_container: short read of container header @0x%lx\n",
 			 offset);
 		ret = -EIO;
@@ -223,7 +224,7 @@ static int read_auth_container(struct spl_image_info *spl_image,
 	length = container->length_lsb + (container->length_msb << 8);
 	debug("Container length %u\n", length);
 
-	if (length > CONTAINER_HDR_ALIGNMENT) {
+	if (length > ctnr_hdr_align) {
 		size = ALIGN(length, spl_get_bl_len(info));
 
 		free(container);
diff --git a/include/imx_container.h b/include/imx_container.h
index 684fc3bc988..5829d685d0a 100644
--- a/include/imx_container.h
+++ b/include/imx_container.h
@@ -12,10 +12,17 @@
 #define IV_MAX_LEN			32
 #define HASH_MAX_LEN			64
 
+#if IS_ENABLED(CONFIG_IMX95)
+u32 container_hdr_alignment(void);
+#else
+static inline u32 container_hdr_alignment(void)
+{
 #if IS_ENABLED(CONFIG_IMX_PQC_SUPPORT)
-#define CONTAINER_HDR_ALIGNMENT 0x4000
+	return 0x4000;
 #else
-#define CONTAINER_HDR_ALIGNMENT 0x400
+	return 0x400;
+#endif
+}
 #endif
 #define CONTAINER_HDR_EMMC_OFFSET 0
 #define CONTAINER_HDR_MMCSD_OFFSET SZ_32K
-- 
2.43.0

