#include "rom5721-db5901.dtsi"

/ {
	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0 0x80000000>;
	};
	
	osc_27m: clock-osc-27m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <27000000>;
		clock-output-names = "osc_27m";
	};
	
	/* Define dummy regulators if board-specific ones aren't available */
	reg_1p8v: regulator-1p8v {
		compatible = "regulator-fixed";
		regulator-name = "1P8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
	
	reg_1p2v: regulator-1p2v {
		compatible = "regulator-fixed";
		regulator-name = "1P2V";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
	};
	
	panel: edp_panel {
		/* Use a standard fallback that exists in the driver */
		compatible = "boe,nv140fhmn49", "simple-panel";
		power-supply = <&reg_3p3v>; /* Ensure this regulator exists */
		status = "okay";
		
		port {
			panel_in: endpoint {
				remote-endpoint = <&sn65dsi86_out>;
			};
		};
	};
	
};

&i2c2 {
	sn65dsi86@2d {
		compatible = "ti,sn65dsi86";
		reg = <0x2d>;
		
		/* Power Supplies - REQUIRED for driver to probe successfully */
		vcca-supply = <&reg_1p2v>;   /* 1.2V Analog */
		vcc-supply = <&reg_1p2v>;    /* 1.2V Digital */
		vccio-supply = <&reg_1p8v>;  /* 1.8V IO */
		vpll-supply = <&reg_1p8v>;   /* 1.8V PLL */
		
		/* Clocks and GPIOs */
		clock-names = "refclk";
		clocks = <&osc_27m>;
		
		/* Enable GPIO for interrupt */
		interrupt-parent = <&gpio1>;
		interrupts = <0 IRQ_TYPE_LEVEL_HIGH>;
		
		/* Allow the bridge to be a GPIO controller (optional but good) */
		gpio-controller;
		#gpio-cells = <2>;
		
		/* Allow the bridge to be a PWM controller (optional) */
		#pwm-cells = <1>;
		
		status = "okay";
		
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			
			port@0 {
				reg = <0>;
				sn65dsi86_from_dsim: endpoint {
					remote-endpoint = <&dsim_to_sn65dsi86>;
				};
			};
			
			port@1 {
				reg = <1>;
				sn65dsi86_out: endpoint {
					data-lanes = <2 1 3 0>;
					lane-polarities = <0 1 0 1>;
					remote-endpoint = <&panel_in>;
				};
			};
		};
	};
};

&mipi_dsi {
	status = "okay";
	/*
	* Ensure we aren't conflicting with other panels.
	* The node name to delete depends on your dtsi, usually panel@0
	*/
	/delete-node/ panel@0;
	
	ports {
		port@1 {
			reg = <1>;
			dsim_to_sn65dsi86: endpoint {
				remote-endpoint = <&sn65dsi86_from_dsim>;
				attach-bridge;
			};
		};
	};
};

&iomuxc {
	pinctrl_dsi2dp_irq: dsi2dpgrp {
		fsl,pins = <
		MX8MM_IOMUXC_GPIO1_IO00_GPIO1_IO0 0x159 /* DSI2DP IRQ */
		>;
	};
};